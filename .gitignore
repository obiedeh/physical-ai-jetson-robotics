# Run directories (reports/<run>/): frame dumps, annotations and per-run
# video are regenerable from the tracked records and are not distributed.
# provenance*.json, session_summary*.json, turns.jsonl and uncommitted*.patch
# stay tracked so cited numbers resolve to tracked files. meta.jsonl is
# per-frame metadata for video composition; it is regenerable with the frames.
reports/*/frames/
reports/*/meta.jsonl
reports/*/anno/
reports/*/*.mp4
reports/**/*.DONE
reports/**/*_DONE
reports/**/G2FINAL

# Raw corpora, LeRobot conversions and fine-tuned checkpoints: not
# distributed, no LFS; available on request (see README, Data availability).
reports/ludo_corpus*/
reports/training/ludo_*/
reports/training/synria_e46_lerobot*/

# Pre-provenance soak runs absent from ludo_stats.csv and every frozen aggregate.
reports/ludo_soak_s[123]/

# Aborted or scratch launches whose meta/turns records are empty.
reports/cup_test*/
reports/dice_dump_val/
reports/dice_rolltest*/
reports/ludo_live_01/
reports/ludo_live_0[456]/
reports/phys_game_val*/

# Rover SLAM sessions (reports/slam/sessions/<name>/): bag data stays out,
# metadata.yaml and the small JSON/JSONL records are committed.
reports/slam/sessions/*/bag/*.db3
reports/slam/sessions/*/bag/*.mcap
reports/slam/sessions/*/bag_record.log

