<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>physical_ai_ops_copilot</name>
  <version>0.1.0</version>
  <description>
    ROS 2 agentic ops copilot node — deterministic triage and optional
    LLM enrichment (AnthropicClassifier) over robot telemetry.
    Subscribes to /robot_telemetry, publishes to /ops_copilot/report.
  </description>

  <maintainer email="obiedeh@gmail.com">Obinna Edeh</maintainer>

  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
