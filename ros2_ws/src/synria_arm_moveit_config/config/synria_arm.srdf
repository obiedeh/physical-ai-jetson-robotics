<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synria 6DOF arm MoveIt SRDF.
  Updated to use real vendor URDF link names (link1..link6, left_gripper,
  right_gripper, tool0) replacing the previous approximate scaffold names.
-->
<robot name="synria_6dof_arm">

  <!-- Planning group: full 6-DOF arm chain -->
  <group name="synria_arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Planning group: arm + C10 wrist camera -->
  <group name="synria_arm_with_camera">
    <chain base_link="base_link" tip_link="c10_camera_link"/>
  </group>

  <end_effector name="tool0" parent_link="tool0" group="synria_arm"/>

  <!-- Adjacent-link collision pairs (real link names from vendor URDF) -->
  <disable_collisions link1="base_link"    link2="link1"         reason="Adjacent"/>
  <disable_collisions link1="link1"        link2="link2"         reason="Adjacent"/>
  <disable_collisions link1="link2"        link2="link3"         reason="Adjacent"/>
  <disable_collisions link1="link3"        link2="link4"         reason="Adjacent"/>
  <disable_collisions link1="link4"        link2="link5"         reason="Adjacent"/>
  <disable_collisions link1="link5"        link2="link6"         reason="Adjacent"/>
  <disable_collisions link1="link6"        link2="tool0"         reason="Adjacent"/>
  <disable_collisions link1="link6"        link2="left_gripper"  reason="Adjacent"/>
  <disable_collisions link1="link6"        link2="right_gripper" reason="Adjacent"/>
  <disable_collisions link1="tool0"        link2="c10_camera_link" reason="Adjacent"/>

  <!-- Gripper fingers don't collide with each other or the wrist -->
  <disable_collisions link1="left_gripper" link2="right_gripper" reason="Default"/>
  <disable_collisions link1="left_gripper" link2="tool0"         reason="Default"/>
  <disable_collisions link1="right_gripper" link2="tool0"        reason="Default"/>

</robot>
