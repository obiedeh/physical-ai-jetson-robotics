    prepend references = @/home/oedeh/github/physical-ai-jetson-robotics/isaac/usd/scenes/synria_mirrored/ludotable_norobot_left.usda@</World>
)
{
    def Xform "SynriaArmMount"
    {
        double3 xformOp:translate = (-0.05, 0, 0.838)
